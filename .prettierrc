{
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "arrowParens": "always",
  "endOfLine": "lf",
  "bracketSpacing": true,
  "jsxSingleQuote": false,
  "overrides": [
    { "files": "*.md", "options": { "printWidth": 100, "proseWrap": "preserve" } },
    { "files": "*.json", "options": { "printWidth": 80 } }
  ]
}
