# =============================================================================
#  BACKEND - BIEN MOI TRUONG
# =============================================================================
#  Cach dung:
#    1. Tu thu muc goc chay:  npm run env:sync   (tao .env tu file nay)
#    2. Dien cac bien [BAT BUOC]
#    3. Kiem tra dong bo:     npm run env:check
#
#  MUC DO QUAN TRONG:
#    [BAT BUOC]  - Khong co thi app KHONG khoi dong duoc (validate fail-fast).
#    [NEN CO]    - Co gia tri mac dinh, nhung production nen dat lai.
#    [TUY CHON]  - Chi can khi bat tinh nang tuong ung.
#
#  CANH BAO: KHONG BAO GIO commit file .env that len git.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. UNG DUNG
# -----------------------------------------------------------------------------

# [NEN CO] Moi truong chay: development | test | production
# Anh huong: log dang JSON, an chi tiet loi 500, bat cookie secure.
NODE_ENV=development

# [NEN CO] Cong HTTP cua backend.
PORT=8000

# [NEN CO] Ten ung dung - hien thi trong log va tieu de email.
APP_NAME=Source Base API

# [NEN CO] Tien to duong dan API. Doi sang /api/v2 khi len phien ban moi.
API_PREFIX=/api/v1

# [NEN CO] Muc log: debug | info | warn | error | silent
# Goi y: development=debug, production=info
LOG_LEVEL=debug


# -----------------------------------------------------------------------------
# 2. URL CONG KHAI
# -----------------------------------------------------------------------------

# [NEN CO] URL goc cua backend (dung khi tao link tuyet doi).
APP_URL=http://localhost:8000

# [BAT BUOC o production] URL cua frontend.
# Dung de: chuyen huong sau OAuth, tao magic link trong email.
CLIENT_URL=http://localhost:5173

# [BAT BUOC o production] Danh sach origin duoc CORS cho phep, phan cach bang dau phay.
# Vi du production: https://app.company.com,https://admin.company.com
CORS_ORIGINS=http://localhost:5173,http://localhost:4173


# -----------------------------------------------------------------------------
# 3. CO SO DU LIEU (MongoDB)
# -----------------------------------------------------------------------------

# [BAT BUOC] Chuoi ket noi MongoDB.
# Cach lay:
#   - Cuc bo:  mongodb://127.0.0.1:27017/source_base
#   - Atlas:   cloud.mongodb.com -> Cluster -> Connect -> Drivers -> copy URI
#              roi thay <password> bang mat khau that.
# LUU Y: neu mat khau co ky tu dac biet (@ : / ?) phai ma hoa URL (URL-encode).
DB_URI=mongodb://127.0.0.1:27017/source_base

# [TUY CHON] Ghi de ten database (neu URI chua chua ten db).
DB_NAME=


# -----------------------------------------------------------------------------
# 4. JWT - KHOA KY TOKEN
# -----------------------------------------------------------------------------

# [BAT BUOC] Khoa bi mat ky ACCESS token. Toi thieu 32 ky tu.
# Cach tao chuoi ngau nhien an toan:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# CANH BAO: lo khoa nay = ke tan cong gia mao duoc moi nguoi dung.
JWT_ACCESS_SECRET=thay-bang-chuoi-ngau-nhien-toi-thieu-32-ky-tu-0001

# [BAT BUOC] Khoa bi mat ky REFRESH token. PHAI KHAC khoa tren (production bat buoc khac).
JWT_REFRESH_SECRET=thay-bang-chuoi-ngau-nhien-toi-thieu-32-ky-tu-0002

# [NEN CO] Han dung access token. Ngan de giam thiet hai khi bi lo. Vi du: 5m, 15m, 1h
JWT_ACCESS_EXPIRES_IN=15m

# [NEN CO] Han dung refresh token. Vi du: 7d, 30d
JWT_REFRESH_EXPIRES_IN=7d

# [NEN CO] Truong "issuer" nhung trong token - giup phan biet token giua cac he thong.
JWT_ISSUER=source-base


# -----------------------------------------------------------------------------
# 5. COOKIE (chua refresh token, httpOnly)
# -----------------------------------------------------------------------------

# [TUY CHON] Domain cua cookie. De trong khi chay cuc bo.
# Dat .company.com neu frontend va backend o 2 subdomain khac nhau.
COOKIE_DOMAIN=

# [NEN CO] lax | strict | none
#   lax    - mac dinh, an toan cho hau het truong hop
#   none   - bat buoc khi frontend va backend KHAC domain (phai kem HTTPS)
COOKIE_SAME_SITE=lax


# -----------------------------------------------------------------------------
# 6. BAO MAT
# -----------------------------------------------------------------------------

# [NEN CO] So vong bam bcrypt. Cao hon = an toan hon nhung cham hon.
# Goi y: 10 (dev) - 12 (production). Moi +1 lam thoi gian bam TANG GAP DOI.
BCRYPT_ROUNDS=10

# [NEN CO] Cua so tinh rate limit (mili giay). 900000 = 15 phut.
RATE_LIMIT_WINDOW_MS=900000

# [NEN CO] So request toi da moi IP trong mot cua so (toan API).
RATE_LIMIT_MAX=100

# [NEN CO] Gioi han rieng cho /auth/login, /auth/register, /auth/magic-link.
# Dat thap de chong do mat khau (brute force).
AUTH_RATE_LIMIT_MAX=10


# -----------------------------------------------------------------------------
# 7. GOOGLE OAUTH (phuong thuc dang nhap #2)
# -----------------------------------------------------------------------------

# [NEN CO] Bat/tat dang nhap bang Google: true | false
# Neu =true thi 3 bien duoi BAT BUOC phai co (app se tu kiem tra khi khoi dong).
GOOGLE_OAUTH_ENABLED=false

# [TUY CHON -> BAT BUOC khi GOOGLE_OAUTH_ENABLED=true]
# Cach tao:
#   1. Vao https://console.cloud.google.com -> tao Project
#   2. APIs & Services -> OAuth consent screen -> chon External -> dien thong tin
#   3. APIs & Services -> Credentials -> Create Credentials -> OAuth client ID
#   4. Application type: Web application
#   5. Authorized redirect URIs: dan dung gia tri GOOGLE_CALLBACK_URL ben duoi
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# [TUY CHON -> BAT BUOC khi bat Google] Phai TRUNG KHOP tuyet doi voi cau hinh tren Google Console.
GOOGLE_CALLBACK_URL=http://localhost:8000/api/v1/auth/google/callback


# -----------------------------------------------------------------------------
# 8. MAGIC LINK (phuong thuc dang nhap #3 - dang nhap khong mat khau)
# -----------------------------------------------------------------------------

# [NEN CO] Bat/tat magic link: true | false
MAGIC_LINK_ENABLED=true

# [NEN CO] Han dung cua link. Ngan de an toan. Vi du: 10m, 15m
MAGIC_LINK_EXPIRES_IN=15m

# [NEN CO] Duong dan tren FRONTEND ma link se tro toi.
# Link day du = CLIENT_URL + duong dan nay + ?token=...
MAGIC_LINK_REDIRECT_PATH=/auth/magic-link/callback


# -----------------------------------------------------------------------------
# 9. EMAIL  (Phase 2)
# -----------------------------------------------------------------------------

# [NEN CO] console | smtp | resend
#   console - in noi dung mail ra log (khong can cau hinh gi, dung khi dev)
#   smtp    - gui that qua SMTP  (Phase 2)
#   resend  - gui qua Resend API (Phase 2)
MAIL_DRIVER=console

# [NEN CO] Dia chi nguoi gui hien thi trong email.
MAIL_FROM=no-reply@example.com

# [TUY CHON -> BAT BUOC khi MAIL_DRIVER=smtp]
# Gmail: bat 2FA roi tao "App password" tai https://myaccount.google.com/apppasswords
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=587
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# [TUY CHON -> BAT BUOC khi MAIL_DRIVER=resend] Lay tai https://resend.com/api-keys
RESEND_API_KEY=


# -----------------------------------------------------------------------------
# 10. CACHE  (Phase 3)
# -----------------------------------------------------------------------------

# [NEN CO] memory | redis
#   memory - luu trong RAM tien trinh (chi dung cho 1 instance)
#   redis  - dung chung nhieu instance (bat buoc khi chay nhieu ban sao)
CACHE_DRIVER=memory

# [TUY CHON -> BAT BUOC khi CACHE_DRIVER=redis]
# Cuc bo: redis://127.0.0.1:6379  | Upstash: lay tai https://console.upstash.com
REDIS_URL=

# [NEN CO] Thoi gian song mac dinh cua cache (giay).
CACHE_TTL_SECONDS=300


# -----------------------------------------------------------------------------
# 11. LUU TRU FILE - CLOUDFLARE R2  (Phase 4)
# -----------------------------------------------------------------------------

# [NEN CO] local | r2
#   local - luu vao thu muc uploads/ (chi dung khi dev)
#   r2    - Cloudflare R2 (tuong thich S3 API)
STORAGE_DRIVER=local

# [TUY CHON -> BAT BUOC khi STORAGE_DRIVER=r2]
# Cach lay:
#   1. dash.cloudflare.com -> R2 -> Create bucket
#   2. R2 -> Manage R2 API Tokens -> Create API Token (quyen Object Read & Write)
#   3. Account ID nam o goc phai trang tong quan R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# [TUY CHON] Domain cong khai cua bucket (bat Public Access hoac gan custom domain).
R2_PUBLIC_URL=

# [NEN CO] Kich thuoc file tai len toi da (MB).
MAX_UPLOAD_SIZE_MB=5


# -----------------------------------------------------------------------------
# 12. CRON JOBS  (Phase 5)
# -----------------------------------------------------------------------------

# [NEN CO] Bat/tat cac tac vu dinh ky: true | false
# CANH BAO: khi chay NHIEU instance chi nen bat tren MOT instance de tranh chay trung.
CRON_ENABLED=false

# [NEN CO] Mui gio tinh lich cron.
CRON_TIMEZONE=Asia/Ho_Chi_Minh


# -----------------------------------------------------------------------------
# 13. TAI KHOAN KHOI TAO (npm run seed)
# -----------------------------------------------------------------------------

# [NEN CO] Tai khoan superAdmin dau tien.
# CANH BAO: DOI mat khau nay ngay sau lan dang nhap dau tien o production.
SEED_SUPER_ADMIN_EMAIL=superadmin@example.com
SEED_SUPER_ADMIN_PASSWORD=SuperAdmin@123
