{
  "name": "@app/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Backend source base: Express 5 + Mongoose + Zod + RBAC",
  "main": "src/index.js",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/index.js",
    "start": "node src/index.js",
    "seed": "node --env-file-if-exists=.env src/seeds/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "lint": "eslint src tests"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "compression": "^1.8.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "google-auth-library": "^10.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.19.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.4",
    "mongodb-memory-server": "^10.1.4",
    "supertest": "^7.1.1",
    "vitest": "^3.2.4"
  }
}
