# =============================================================================
#  FRONTEND - BIEN MOI TRUONG (Vite)
# =============================================================================
#  QUY TAC QUAN TRONG:
#    Chi bien co tien to `VITE_` moi duoc dua vao code trinh duyet.
#    MOI gia tri o day deu CONG KHAI - nguoi dung xem duoc trong DevTools.
#    => TUYET DOI khong dat secret, API key rieng tu, mat khau tai day.
#
#  Cach dung:
#    1. Tu thu muc goc chay:  npm run env:sync
#    2. Kiem tra dong bo:     npm run env:check
#
#  MUC DO QUAN TRONG:
#    [BAT BUOC] / [NEN CO] / [TUY CHON]
# =============================================================================


# -----------------------------------------------------------------------------
# 1. KET NOI BACKEND
# -----------------------------------------------------------------------------

# [NEN CO] Duong dan goc toi API.
# De MAC DINH la "/api/v1" khi chay dev: Vite se proxy sang backend
# (xem `server.proxy` trong vite.config.js) -> trinh duyet coi la cung origin
# nen cookie refresh token hoat dong binh thuong, khong vuong CORS.
#
# Khi frontend va backend deploy KHAC domain, dien URL day du:
#   VITE_API_BASE_URL=https://api.company.com/api/v1
VITE_API_BASE_URL=/api/v1

# [NEN CO] Dich ma Vite proxy toi khi chay dev. Chi co tac dung o moi truong dev.
# Phai khop voi PORT cua backend.
VITE_PROXY_TARGET=http://localhost:8000

# [NEN CO] Thoi gian cho toi da moi request (mili giay).
VITE_API_TIMEOUT=15000


# -----------------------------------------------------------------------------
# 2. HIEN THI
# -----------------------------------------------------------------------------

# [NEN CO] Ten ung dung - hien thi tren thanh dieu huong va tieu de trang.
VITE_APP_NAME=Source Base

# [TUY CHON] Bat cong cu go roi TanStack Query o goc man hinh: true | false
# Chi nen bat khi dev.
VITE_ENABLE_QUERY_DEVTOOLS=true


# -----------------------------------------------------------------------------
# 3. BAT / TAT TINH NANG (feature flag)
# -----------------------------------------------------------------------------
#  Cac co nay chi AN nut tren giao dien. Backend van la noi quyet dinh cuoi cung,
#  nen phai dat GIONG voi cau hinh tuong ung o backend/.env.

# [NEN CO] Hien nut "Dang nhap voi Google": true | false
# Phai khop voi GOOGLE_OAUTH_ENABLED o backend.
VITE_ENABLE_GOOGLE_LOGIN=false

# [NEN CO] Hien form "Dang nhap bang magic link": true | false
# Phai khop voi MAGIC_LINK_ENABLED o backend.
VITE_ENABLE_MAGIC_LINK=true
